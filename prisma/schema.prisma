generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model Category {
  id String @id @default(cuid())
  name String
  sort_order Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  sites Site[]
  @@index([sort_order])
  @@map("categories")
}
model Site {
  id String @id @default(cuid())
  category_id String
  category Category @relation(fields: [category_id], references: [id], onDelete: Restrict)
  name String
  url String
  icon_type String @default("default")
  icon_url String?
  description String?
  sort_order Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  @@index([category_id, sort_order])
  @@map("sites")
}
model Settings {
  id String @id @default("singleton")
  site_name String @default("我的导航")
  site_logo String?
  admin_password_hash String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  @@map("settings")
}
model AdminSession {
  id String @id
  expires_at DateTime
  created_at DateTime @default(now())
  @@index([expires_at])
  @@map("admin_sessions")
}
