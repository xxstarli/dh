{
  "name": "personal-navigation-validation",
  "version": "1.2.0",
  "private": true,
  "description": "Development checks only; production runs directly on PHP-FPM",
  "scripts": {
    "dev": "node scripts/php.mjs -S localhost:3000 -t public scripts/router.php",
    "lint": "node scripts/php.mjs scripts/check.php && eslint public/assets/*.js scripts/*.mjs tests/*.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/php.mjs scripts/check.php && node scripts/package.mjs",
    "test": "node scripts/php.mjs tests/php/run.php && node tests/transport.mjs",
    "test:e2e": "playwright test",
    "test:restart": "node tests/restart.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
